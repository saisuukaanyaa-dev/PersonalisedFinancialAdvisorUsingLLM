# Personal Finance Advisor - team test bundle
# ./start.sh copies this to .env and fills the generated secrets. Never commit or share your .env.

# --- REQUIRED: your own OpenAI API key (start.sh asks for it if empty) ---
OPENAI_API_KEY=

# Optional: OpenAI-compatible endpoint (leave empty for api.openai.com)
OPENAI_BASE_URL=

# --- generated by start.sh ---
POSTGRES_PASSWORD=replace-with-a-strong-password
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
MCP_BEARER_TOKEN=replace-with-a-random-token

# --- defaults (change a port if it is already used on your machine) ---
POSTGRES_USER=pfa
POSTGRES_DB=finance_advisor
POSTGRES_PORT=5433
MARKET_API_PORT=8000
N8N_PORT=5678
GENERIC_TIMEZONE=Asia/Kolkata
