# Personal Finance Advisor - Python edition
# ./start.sh copies this to .env and fills the generated secrets. Never commit or share your .env.

# --- REQUIRED for AI text and chat: your own OpenAI API key (start.sh asks for it) ---
# Without it the app still works: every number, chart and plan is computed; the explanation uses built-in text.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
# low = fastest answers; medium = more thorough but slower
OPENAI_REASONING_EFFORT=low

# --- OPTIONAL: Google sign-in (email + password always works) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorised redirect URI: http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Address people use to open the app (used for the Google redirect). No trailing slash.
PUBLIC_BASE_URL=http://localhost:8080
APP_PORT=8080
POSTGRES_PORT=5434
# Set to true only when the app is served over https
COOKIE_SECURE=false

# --- generated by start.sh ---
POSTGRES_USER=pfa
POSTGRES_DB=finance_advisor
POSTGRES_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-string

# --- Live data via SerpAPI (optional; https://serpapi.com - free plan 250 searches/month, 50/hour) ---
# Without a key the app uses only the built-in knowledge base. With it:
#   - at start (at most once every SERPAPI_REFRESH_HOURS) the knowledge base is updated with today's date,
#     the NIFTY 50 level, recent index additions/removals and the latest prices of a few stocks (rotating)
#   - the chat router fetches live data only for time-sensitive questions (cached SERPAPI_CACHE_HOURS)
SERPAPI_API_KEY=
SERPAPI_MONTHLY_LIMIT=250
# searches kept for the chat - the startup refresh never uses these
SERPAPI_CHAT_RESERVE=60
SERPAPI_REFRESH_BUDGET=10
SERPAPI_REFRESH_HOURS=24
SERPAPI_QUOTES_PER_REFRESH=6
SERPAPI_CACHE_HOURS=12
# cost per search for the usage page: 0 on the free plan, 0.025 on Starter ($25 / 1,000)
PRICE_SERPAPI_SEARCH=0.025

# --- Voice chat (new in v1.3) - nothing listens or speaks unless the user presses 🎙 / 🔊 or turns on "Read replies aloud" ---
# browser = the browser's own speech recognition and voices: free (Chrome, Edge, Safari)
# openai  = adds a "Natural voice" option: speech to text ≈ ₹0.04 per 10-second question, read-aloud ≈ ₹1 per reply
VOICE_ENGINE=browser
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=sage
PRICE_STT_PER_MIN=0.003
# estimate: OpenAI bills TTS audio tokens and doesn't report them
PRICE_TTS_PER_MIN=0.015
VOICE_DAILY_LIMIT_PER_USER=60

# --- Observability: traces to Arize Phoenix (dashboard at http://localhost:6006) ---
# Leave PHOENIX_COLLECTOR_ENDPOINT unset to use the bundled Phoenix; set it empty to switch tracing off.
PHOENIX_PORT=6006
PHOENIX_PROJECT=pfa-python
# true = traces include prompts, answers and plan figures (ID numbers masked). false = only timings, tokens and costs.
PFA_TRACE_CONTENT=true

# --- AI cost metering (USD per 1M tokens, OpenAI standard tier, checked 28 Sep 2026) ---
PRICE_CHAT_INPUT_PER_M=0.25
PRICE_CHAT_CACHED_PER_M=0.025
PRICE_CHAT_OUTPUT_PER_M=2.00
PRICE_EMBED_PER_M=0.02
# Update to today's rate for rupee figures
USD_TO_INR=88
